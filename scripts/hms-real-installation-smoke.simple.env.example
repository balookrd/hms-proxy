# Copy to scripts/hms-real-installation-smoke.simple.env or pass with:
#   scripts/run-real-installation-smoke-simple.sh --env-file /path/to/file.env

HMS_SMOKE_AUTH=simple
HMS_SMOKE_URI=thrift://proxy-host:9083

# Optional Beeline / HiveServer2 SQL smoke from SMOKE.md. If unset, the SQL step is skipped in --scenario all.
# HMS_SMOKE_BEELINE_JDBC_URL=jdbc:hive2://proxy-host:10000/default
# HMS_SMOKE_BEELINE_BIN=beeline
# HMS_SMOKE_BEELINE_USER=smoke-user
# HMS_SMOKE_BEELINE_PASSWORD=
# HMS_SMOKE_HDP_CATALOG=hdp
# HMS_SMOKE_APACHE_CATALOG=apache
# HMS_SMOKE_HDP_READ_TABLE=some_table
# HMS_SMOKE_APACHE_READ_TABLE=some_table
# HMS_SMOKE_SQL_EXTERNAL_ROOT=/tmp/hms-proxy-smoke
# HMS_SMOKE_HDP_EXTERNAL_ROOT=hdfs://nameservice-hdp/tmp/hms-proxy-smoke/hdp
# HMS_SMOKE_APACHE_EXTERNAL_ROOT=hdfs://nameservice-apache/tmp/hms-proxy-smoke/apache
# HMS_SMOKE_SQL_RUN_VIEW_REWRITE=true
# HMS_SMOKE_SQL_RUN_UDF=true
# HMS_SMOKE_SQL_UDF_CLASS=org.apache.hadoop.hive.ql.udf.UDFReverse
# HMS_SMOKE_SQL_UDF_EXPECTED_RESULT=yxorp
# HMS_SMOKE_SQL_RUN_MATERIALIZED_VIEW=false
# One statement reading two catalogs, which is what makes Hive send a lock request whose components
# span them. Enabled by default; it only reads.
# HMS_SMOKE_SQL_RUN_CROSS_CATALOG_JOIN=true
# The same shape within one catalog. Off by default: it creates a database.
# HMS_SMOKE_SQL_RUN_CROSS_DATABASE_JOIN=false
# A second HiveServer2 on the proxy's Hortonworks front door. Thrift cannot negotiate versions, so
# an Apache and an HDP client never reach the same listener; setting this runs the whole SQL suite
# a second time against the Hortonworks one, which is the only way both combinations get covered.
# HMS_SMOKE_BEELINE_HDP_JDBC_URL=jdbc:hive2://hs2-hdp:10000/default
# HMS_SMOKE_BEELINE_HDP_USER=hive
# HMS_SMOKE_HDP_RUN_TRANSACTIONAL_SQL=false
# HMS_SMOKE_APACHE_RUN_TRANSACTIONAL_SQL=false
# Note: an unqualified /tmp/... LOCATION in Beeline is resolved by the connected HiveServer2 fs.defaultFS.
# Use the per-catalog *_EXTERNAL_ROOT variables above when each backend must land on its own HDFS namespace.

# Optional fat jar override. By default the runner uses the newest target/hms-proxy-*-fat.jar.
# HMS_SMOKE_FAT_JAR=/opt/hms-proxy/hms-proxy-fat.jar

# Optional repeated HiveConf overrides separated by ';'
# HMS_SMOKE_EXTRA_CONF=hive.metastore.execute.setugi=false;hive.metastore.token.signature=proxy

HMS_SMOKE_USER=smoke-user
HMS_SMOKE_HOST=localhost
HMS_SMOKE_AGENT_INFO=hms-proxy-real-installation-smoke-simple

# Direct ACID / txn smoke
HMS_SMOKE_TXN_DB=hdp__default
HMS_SMOKE_TXN_TABLE=smoke_txn_tbl
HMS_SMOKE_TXN_LOCK=true

# Optional second txn target, for example to validate both default Apache and default Hortonworks catalogs.
# HMS_SMOKE_TXN_SECONDARY_DB=apache__default
# HMS_SMOKE_TXN_SECONDARY_TABLE=smoke_txn_tbl

# Non-default catalog synthetic lock smoke
HMS_SMOKE_LOCK_DB=apache__default
HMS_SMOKE_DB_LOCK_TYPE=SHARED_READ
HMS_SMOKE_DB_LOCK_LEVEL=DB
HMS_SMOKE_DB_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_DB_LOCK_TRANSACTIONAL=false
HMS_SMOKE_LOCK_HEARTBEAT=true
HMS_SMOKE_LOCK_UNLOCK=true
HMS_SMOKE_LOCK_CLOSE_TXN=abort

# Optional partition rename/drop style lock smoke
HMS_SMOKE_LOCK_TABLE=smoke_managed_tbl
HMS_SMOKE_LOCK_PARTITION=p=2026-04-01
HMS_SMOKE_PARTITION_LOCK_TYPE=EXCLUSIVE
HMS_SMOKE_PARTITION_LOCK_LEVEL=PARTITION
HMS_SMOKE_PARTITION_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_PARTITION_LOCK_TRANSACTIONAL=false

# Optional cross-catalog lock smoke: one lock request whose components name two catalogs, the shape
# Hive builds for any query reading across them. The first component comes from HMS_SMOKE_TXN_DB, so
# the request routes by the default catalog; the component below is the one the proxy drops.
# If left unset, the step is skipped in --scenario all.
# HMS_SMOKE_CROSS_CATALOG_LOCK_DB=apache__default
# HMS_SMOKE_CROSS_CATALOG_LOCK_TABLE=smoke_read_tbl

# Optional Hortonworks notification smoke. If left unset, the notification step is skipped in --scenario all.
# add_write_notification_log only exists on a Hortonworks front door, which usually listens on its own
# port because Thrift cannot negotiate versions; this overrides HMS_SMOKE_URI for the notification step.
# HMS_SMOKE_NOTIFICATION_URI=thrift://proxy-host:9084
# HMS_SMOKE_NOTIFICATION_DB=hdp__default
# HMS_SMOKE_NOTIFICATION_TABLE=smoke_txn_tbl
# HMS_SMOKE_NOTIFICATION_TXN_ID=1001
# HMS_SMOKE_NOTIFICATION_WRITE_ID=2001
# HMS_SMOKE_NOTIFICATION_FILES_ADDED=hdfs:///warehouse/tablespace/managed/hive/smoke_txn_tbl/delta_1001_1001_0000/bucket_00000
# HMS_SMOKE_NOTIFICATION_PARTITIONS=p=2026-04-01
# HMS_SMOKE_NOTIFICATION_NEGATIVE_DB=apache__default
# HMS_SMOKE_NOTIFICATION_NEGATIVE_TABLE=smoke_txn_tbl
# HMS_SMOKE_HDP_STANDALONE_METASTORE_JAR=/opt/hms-proxy/hive-metastore/hive-standalone-metastore-3.1.0.3.1.0.0-78.jar

# Optional Iceberg REST catalog smoke (read-only HTTP endpoint, driven with curl). If left unset,
# the REST step is skipped in --scenario all. The prefix must equal the proxy's
# routing.default-catalog; the Iceberg table must carry table_type=ICEBERG and a readable
# metadata_location, and the non-Iceberg table proves plain Hive tables stay invisible over REST.
# HMS_SMOKE_REST_URL=http://proxy-host:9183
# HMS_SMOKE_REST_PREFIX=hdp
# HMS_SMOKE_REST_NAMESPACE=default
# HMS_SMOKE_REST_ICEBERG_TABLE=smoke_iceberg_tbl
# HMS_SMOKE_REST_NON_ICEBERG_TABLE=smoke_read_tbl
