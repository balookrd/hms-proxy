# Kerberos variant of the hive4 profile. Pass it to every compose call:
#   docker compose --env-file .env.hive4-kerberos --profile hive4 --profile hdp --profile kerberos up -d --build
#
# Same rationale as .env.kerberos: a compose call without these variables silently restarts the
# proxy without SASL, which then hangs the Kerberos-enabled HiveServer2 in its handshake.
KERBEROS_ENABLED=true
PROXY_CONFIG=/opt/hms-proxy/hms-proxy-hive4-kerberos.properties
HDFS_KERBEROS_ENV=./hdfs/hadoop-kerberos.env
HS2_PLATFORM=linux/amd64
HDFS_KERBEROS_ENV_B=./hdfs/hadoop-kerberos-b.env
