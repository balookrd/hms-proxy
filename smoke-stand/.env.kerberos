# Kerberos profile for the stand. Pass it to every compose call:
#   docker compose --env-file .env.kerberos --profile kerberos up -d --build
#
# Keeping these in a file matters: compose recreates dependencies when they are reached through
# depends_on, and a call that omits the variables silently restarts the proxy without SASL, which
# then hangs the Kerberos-enabled HiveServer2 in its handshake.
KERBEROS_ENABLED=true
PROXY_CONFIG=/opt/hms-proxy/hms-proxy-kerberos.properties
HDFS_KERBEROS_ENV=./hdfs/hadoop-kerberos.env
HS2_PLATFORM=linux/amd64
HDFS_KERBEROS_ENV_B=./hdfs/hadoop-kerberos-b.env
