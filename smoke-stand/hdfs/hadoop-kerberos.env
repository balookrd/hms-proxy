# Secure HDFS for the Kerberos profile, layered on top of hadoop.env.
#
# A kerberized datanode normally has to bind privileged ports (< 1024) under jsvc to prove it is
# root-owned. SASL data transfer protection is the supported alternative: with
# dfs.data.transfer.protection set and an HTTPS-free web policy, the datanode authenticates its
# data plane over SASL and can keep its ordinary ports, which is what a container needs.

CORE_CONF_hadoop_security_authentication=kerberos
CORE_CONF_hadoop_security_authorization=true
CORE_CONF_hadoop_rpc_protection=authentication
CORE_CONF_hadoop_security_auth__to__local=RULE:[2:$1@$0](.*@SMOKE.LOCAL)s/@.*//\nRULE:[1:$1@$0](.*@SMOKE.LOCAL)s/@.*//\nDEFAULT

HDFS_CONF_dfs_block_access_token_enable=true
HDFS_CONF_dfs_data_transfer_protection=authentication
# A secure datanode may skip privileged ports only when SASL data transfer protection is on AND
# the web policy is HTTPS_ONLY - Hadoop refuses to start otherwise ("Cannot start secure DataNode
# due to incorrect config"). Hence the self-signed keystore mounted at /ssl.
HDFS_CONF_dfs_http_policy=HTTPS_ONLY
HDFS_CONF_dfs_https_enable=true
HDFS_CONF_dfs_client_https_need__auth=false
HDFS_CONF_dfs_datanode_https_address=0.0.0.0:9865
HDFS_CONF_dfs_namenode_https__address=0.0.0.0:9871
HDFS_CONF_dfs_encrypt_data_transfer=false

HDFS_CONF_dfs_namenode_kerberos_principal=hdfs/namenode@SMOKE.LOCAL
HDFS_CONF_dfs_namenode_keytab_file=/keytabs/namenode.keytab
HDFS_CONF_dfs_web_authentication_kerberos_principal=HTTP/namenode@SMOKE.LOCAL
HDFS_CONF_dfs_web_authentication_kerberos_keytab=/keytabs/namenode.keytab

HDFS_CONF_dfs_datanode_kerberos_principal=hdfs/datanode@SMOKE.LOCAL
HDFS_CONF_dfs_datanode_keytab_file=/keytabs/datanode.keytab

# The proxy, HiveServer2 and the metastores all reach HDFS as their own principals.
CORE_CONF_hadoop_proxyuser_hive_hosts=*
CORE_CONF_hadoop_proxyuser_hive_groups=*
CORE_CONF_hadoop_proxyuser_hdfs_hosts=*
CORE_CONF_hadoop_proxyuser_hdfs_groups=*
