# Secure HDFS for the *second* cluster. Same shape as hadoop-kerberos.env, with this cluster's own
# service principals; both clusters live in one realm (SMOKE.LOCAL), so a client holding a single
# TGT can reach either one. That is what makes a query reading across both filesystems possible
# without cross-realm trust, which would test the KDC rather than the proxy.

CORE_CONF_hadoop_security_authentication=kerberos
CORE_CONF_hadoop_security_authorization=true
CORE_CONF_hadoop_rpc_protection=authentication
CORE_CONF_hadoop_security_auth__to__local=RULE:[2:$1@$0](.*@SMOKE.LOCAL)s/@.*//\nRULE:[1:$1@$0](.*@SMOKE.LOCAL)s/@.*//\nDEFAULT

HDFS_CONF_dfs_block_access_token_enable=true
HDFS_CONF_dfs_data_transfer_protection=authentication
HDFS_CONF_dfs_http_policy=HTTPS_ONLY
HDFS_CONF_dfs_https_enable=true
HDFS_CONF_dfs_client_https_need__auth=false
HDFS_CONF_dfs_datanode_https_address=0.0.0.0:9865
HDFS_CONF_dfs_namenode_https__address=0.0.0.0:9871
HDFS_CONF_dfs_encrypt_data_transfer=false

HDFS_CONF_dfs_namenode_kerberos_principal=hdfs/namenode-b@SMOKE.LOCAL
HDFS_CONF_dfs_namenode_keytab_file=/keytabs/namenode-b.keytab
HDFS_CONF_dfs_web_authentication_kerberos_principal=HTTP/namenode-b@SMOKE.LOCAL
HDFS_CONF_dfs_web_authentication_kerberos_keytab=/keytabs/namenode-b.keytab

HDFS_CONF_dfs_datanode_kerberos_principal=hdfs/datanode-b@SMOKE.LOCAL
HDFS_CONF_dfs_datanode_keytab_file=/keytabs/datanode-b.keytab

CORE_CONF_hadoop_proxyuser_hive_hosts=*
CORE_CONF_hadoop_proxyuser_hive_groups=*
CORE_CONF_hadoop_proxyuser_hdfs_hosts=*
CORE_CONF_hadoop_proxyuser_hdfs_groups=*
