# apache-default profile of the stand, plain auth. Pass it to every compose call:
#   docker compose --env-file .env.apache --profile hdp --profile hive4fe up -d --build
#
# Swaps the roles of the two 3.1-line metastores: the Apache 3.1.3 one becomes the default
# catalog (and so the only write-capable one), the Hortonworks one becomes non-default. Used by
# the Iceberg interop scenario to exercise the APACHE_3_1_3 runtime on the write path.
PROXY_CONFIG=/opt/hms-proxy/hms-proxy-apache.properties
