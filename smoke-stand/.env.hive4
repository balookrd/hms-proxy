# Hive 4 profile for the stand, plain auth. Pass it to every compose call:
#   docker compose --env-file .env.hive4 --profile hive4 --profile hdp up -d --build
#
# The default catalog becomes an Apache Hive 4.1.0 metastore (container hms-hive4); the two
# 3.1-dialect SQL front doors and the Iceberg REST front door all route to it. The hdp profile
# is included for the vendor HiveServer2, which the Iceberg interop scenario drives.
PROXY_CONFIG=/opt/hms-proxy/hms-proxy-hive4.properties
