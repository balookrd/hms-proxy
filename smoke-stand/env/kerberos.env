# Smoke settings for the fully kerberized stand.
#
# Run it from inside the compose network — the KDC, the proxy and the service principals all
# resolve by container name:
#   docker cp scripts stand-proxy:/opt/hms-proxy/
#   docker exec stand-proxy /opt/hms-proxy/scripts/run-real-installation-smoke-kerberos.sh \
#     --env-file /opt/hms-proxy/smoke-env/kerberos.env --scenario all

HMS_SMOKE_AUTH=kerberos
HMS_SMOKE_URI=thrift://proxy:9083
HMS_SMOKE_SERVER_PRINCIPAL=hive/proxy@SMOKE.LOCAL
HMS_SMOKE_CLIENT_PRINCIPAL=smoke-user@SMOKE.LOCAL
HMS_SMOKE_KEYTAB=/keytabs/smoke-user.keytab
HMS_SMOKE_KRB5_CONF=/etc/krb5.conf
HMS_SMOKE_FAT_JAR=/opt/hms-proxy/hms-proxy.jar

HMS_SMOKE_USER=smoke-user
HMS_SMOKE_HOST=proxy
HMS_SMOKE_AGENT_INFO=hms-proxy-smoke-stand-kerberos

# The metastore runs a TUGIBasedProcessor; the proxy owns identity, so the client must not send
# its own set_ugi when opening the connection.
HMS_SMOKE_EXTRA_CONF=hive.metastore.execute.setugi=false

# ACID lives in the default catalog (hdp).
HMS_SMOKE_TXN_DB=hdp__default
HMS_SMOKE_TXN_TABLE=smoke_txn_tbl
HMS_SMOKE_TXN_LOCK=true

# Locks against a non-default catalog are served by the synthetic shim.
HMS_SMOKE_LOCK_DB=apache__default
HMS_SMOKE_DB_LOCK_TYPE=SHARED_READ
HMS_SMOKE_DB_LOCK_LEVEL=DB
HMS_SMOKE_DB_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_DB_LOCK_TRANSACTIONAL=false
HMS_SMOKE_LOCK_HEARTBEAT=true
HMS_SMOKE_LOCK_UNLOCK=true
HMS_SMOKE_LOCK_CLOSE_TXN=abort

# Partition-style exclusive lock, the second synthetic-shim shape.
HMS_SMOKE_LOCK_TABLE=smoke_managed_tbl
HMS_SMOKE_LOCK_PARTITION=p=2026-04-01
HMS_SMOKE_PARTITION_LOCK_TYPE=EXCLUSIVE
HMS_SMOKE_PARTITION_LOCK_LEVEL=PARTITION
HMS_SMOKE_PARTITION_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_PARTITION_LOCK_TRANSACTIONAL=false

# Hortonworks write-notification path: needs the HDP metastore jar for the front-door runtime.
HMS_SMOKE_NOTIFICATION_DB=hdp__default
HMS_SMOKE_NOTIFICATION_TABLE=smoke_txn_tbl
HMS_SMOKE_NOTIFICATION_TXN_ID=1001
HMS_SMOKE_NOTIFICATION_WRITE_ID=2001
HMS_SMOKE_NOTIFICATION_FILES_ADDED=hdfs://namenode:8020/warehouse/hdp/smoke_txn_tbl/delta_1001_1001_0000/bucket_00000
HMS_SMOKE_NOTIFICATION_NEGATIVE_DB=apache__default
HMS_SMOKE_NOTIFICATION_NEGATIVE_TABLE=smoke_txn_tbl
HMS_SMOKE_HDP_STANDALONE_METASTORE_JAR=/opt/hms-proxy/hive-metastore/hive-standalone-metastore-3.1.0.3.1.0.0-78.jar
