# SQL layer of the stand with the APACHE 3.1.3 metastore as the default catalog (.env.apache).
# Same as sql.env except for the transactional flags - see the note on them below.
#
# Original header of sql.env follows.
#
# SQL layer of the stand, plain profile. Separate from simple.env on purpose: that file is meant
# to be run from the host, where there is no beeline, so its SQL settings stay commented out and
# `--scenario all` skips the SQL smoke there. This file is the in-container counterpart, and it
# leaves those settings on, so `--scenario sql` actually drives sections B and C of TEST-MATRIX.md
# instead of being skipped.
#
# Run it from the Hortonworks HiveServer2 container - it carries a beeline that reaches both front
# doors, and in-network DNS resolves the container names:
#
#   docker cp scripts/run-real-installation-smoke.sh stand-hs2-hdp:/opt/hs2-hdp/run-smoke.sh
#   docker cp smoke-stand/env/sql.env stand-hs2-hdp:/opt/hs2-hdp/sql.env
#   docker exec stand-hs2-hdp /opt/hs2-hdp/run-smoke.sh --env-file /opt/hs2-hdp/sql.env --scenario sql
#
# With both JDBC URLs set the suite runs twice - once against the Apache front door and once
# against the Hortonworks one. That is the only way the HDP client path gets covered: Thrift has no
# version negotiation, so neither client can use the other's listener.

HMS_SMOKE_AUTH=simple
HMS_SMOKE_URI=thrift://proxy:9083
HMS_SMOKE_USER=smoke-user
HMS_SMOKE_HOST=proxy
HMS_SMOKE_AGENT_INFO=hms-proxy-smoke-stand-sql
HMS_SMOKE_EXTRA_CONF=hive.metastore.execute.setugi=false

HMS_SMOKE_BEELINE_JDBC_URL=jdbc:hive2://hs2:10000/default
HMS_SMOKE_BEELINE_HDP_JDBC_URL=jdbc:hive2://hs2-hdp:10000/default
HMS_SMOKE_BEELINE_USER=hive

HMS_SMOKE_APACHE_CATALOG=apache
HMS_SMOKE_HDP_CATALOG=hdp
HMS_SMOKE_HDP_READ_TABLE=smoke_read_hdp
HMS_SMOKE_APACHE_READ_TABLE=smoke_read_ap
HMS_SMOKE_HDP_EXTERNAL_ROOT=hdfs://namenode:8020/external/hdp
# The apache catalog lives on the second cluster, so its external root does too.
HMS_SMOKE_APACHE_EXTERNAL_ROOT=hdfs://namenode-b:8020/external/apache

HMS_SMOKE_SQL_RUN_CROSS_DATABASE_JOIN=true

# The transactional blocks. These default to false in the runner, and leaving them off is what
# made section C2 a claim without a run: the SQL scenario never created an ACID table on the
# stand. ACID state belongs to the default catalog, so only the one matching this profile's
# default is expected to succeed - see TEST-MATRIX.md section F, "ACID on a non-default catalog".
#
# KNOWN FAILURE, first surfaced 2026-08-03 by turning this on: the suite runs twice, once per
# front door, and the ACID block fails on the *Apache* front-door pass while the same statements
# succeed through the Hortonworks one. The insert itself lands - the MapReduce job finishes and
# the delta file is written - and then the stats update is refused by the metastore with
# "Cannot change stats state for a transactional table without providing the transactional write
# state for verification (new write ID -1, valid write IDs null)". Hive reports it as
# "[Warning] could not update stats" followed by a failing StatsTask.
#
# The gate has two axes now: the catalog flags below say which catalog gets a transactional table,
# and HMS_SMOKE_TRANSACTIONAL_SQL_FRONT_DOORS says through which front doors that is attempted at
# all. Its default, `hdp`, is what the measurement above justifies - so the ACID block runs on the
# Hortonworks pass, where it works, and is not attempted on the Apache one, where it does not.
# Setting it to "apache hdp" reproduces the failure on demand.
HMS_SMOKE_HDP_RUN_TRANSACTIONAL_SQL=false
# Deliberately off, and it cannot be turned on: with an Apache 3.1.3 metastore as the default
# catalog there is no ACID path at all. Hive issues add_write_notification_log itself after an
# ACID write, and the proxy refuses the Hortonworks-shaped call whenever the backend is not a
# Hortonworks runtime (AddWriteNotificationLogHandler; TEST-MATRIX row A6 records that refusal as
# correct). The statement then dies in MoveTask with a bare
# "Internal error processing add_write_notification_log" - libthrift 0.9.3 drops the real message.
HMS_SMOKE_APACHE_RUN_TRANSACTIONAL_SQL=true
# Mirror of sql.env: here the Apache metastore is the default catalog, so only the Apache front
# door runs and the Hortonworks one is a remote catalog.
HMS_SMOKE_SQL_FRONT_DOORS=apache
# The ACID block follows the front door in use.
HMS_SMOKE_TRANSACTIONAL_SQL_FRONT_DOORS=apache

# The runner checks for a fat jar at startup even for --scenario sql, and the HiveServer2 container
# has no target/ directory. Point it at the copy staged next to the runner:
#   docker cp smoke-stand/proxy/hms-proxy-fat.jar stand-hs2-hdp:/opt/hs2-hdp/hms-proxy-fat.jar
HMS_SMOKE_FAT_JAR=/opt/hs2-hdp/hms-proxy-fat.jar

# The Hortonworks HiveServer2 has no MapReduce in its build, so the engine cannot be named in
# hive-site.xml, and the stand has no YARN for the vendor default of Tez. `set` is the only place
# left to choose, and without it the HDP pass dies with
# NoClassDefFoundError: org/apache/tez/runtime/api/Event.
HMS_SMOKE_SQL_HDP_SESSION_INIT=set hive.execution.engine=mr; set hive.vectorized.execution.enabled=false;
