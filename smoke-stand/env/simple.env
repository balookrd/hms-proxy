# Smoke settings for the local docker-compose stand (no Kerberos).
#   scripts/run-real-installation-smoke-simple.sh --env-file smoke-stand/env/simple.env --scenario all

HMS_SMOKE_AUTH=simple
HMS_SMOKE_URI=thrift://localhost:19085

HMS_SMOKE_USER=smoke-user
HMS_SMOKE_HOST=localhost
HMS_SMOKE_AGENT_INFO=hms-proxy-smoke-stand

# The metastore runs a TUGIBasedProcessor; the proxy owns identity, so the client must not
# send its own set_ugi when opening the connection.
HMS_SMOKE_EXTRA_CONF=hive.metastore.execute.setugi=false

# ACID lives in the default catalog (hdp).
HMS_SMOKE_TXN_DB=hdp__default
HMS_SMOKE_TXN_TABLE=smoke_txn_tbl
HMS_SMOKE_TXN_LOCK=true

# No secondary txn target: this stand has a single default catalog (hdp), and the proxy
# deliberately refuses ACID against a non-default catalog. Set this only when a second catalog
# is itself the default for its own front door.

# Locks against a non-default catalog are served by the synthetic shim.
HMS_SMOKE_LOCK_DB=apache__default
HMS_SMOKE_DB_LOCK_TYPE=SHARED_READ
HMS_SMOKE_DB_LOCK_LEVEL=DB
HMS_SMOKE_DB_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_DB_LOCK_TRANSACTIONAL=false
HMS_SMOKE_LOCK_HEARTBEAT=true
HMS_SMOKE_LOCK_UNLOCK=true
HMS_SMOKE_LOCK_CLOSE_TXN=abort

# Partition-style exclusive lock, the second synthetic-shim shape.
HMS_SMOKE_LOCK_TABLE=smoke_managed_tbl
HMS_SMOKE_LOCK_PARTITION=p=2026-04-01
HMS_SMOKE_PARTITION_LOCK_TYPE=EXCLUSIVE
HMS_SMOKE_PARTITION_LOCK_LEVEL=PARTITION
HMS_SMOKE_PARTITION_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_PARTITION_LOCK_TRANSACTIONAL=false

# Beeline/HiveServer2 is not part of this stand, so the sql scenario stays skipped.

# HiveServer2 layer. Beeline runs inside the stand's HS2 container, which is where the Hive
# client libraries live; from the host there is no beeline and no in-network DNS.
# HMS_SMOKE_BEELINE_JDBC_URL=jdbc:hive2://localhost:10000/default
# HMS_SMOKE_BEELINE_USER=hive
# HMS_SMOKE_APACHE_CATALOG=apache
# HMS_SMOKE_HDP_CATALOG=hdp
