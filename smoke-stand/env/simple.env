# Smoke settings for the local docker-compose stand (no Kerberos).
#   scripts/run-real-installation-smoke-simple.sh --env-file smoke-stand/env/simple.env --scenario all

HMS_SMOKE_AUTH=simple
HMS_SMOKE_URI=thrift://localhost:19085

HMS_SMOKE_USER=smoke-user
HMS_SMOKE_HOST=localhost
HMS_SMOKE_AGENT_INFO=hms-proxy-smoke-stand

# The metastore runs a TUGIBasedProcessor; the proxy owns identity, so the client must not
# send its own set_ugi when opening the connection.
HMS_SMOKE_EXTRA_CONF=hive.metastore.execute.setugi=false

# ACID lives in the default catalog (hdp).
HMS_SMOKE_TXN_DB=hdp__default
HMS_SMOKE_TXN_TABLE=smoke_txn_tbl
HMS_SMOKE_TXN_LOCK=true

# No secondary txn target: this stand has a single default catalog (hdp), and the proxy
# deliberately refuses ACID against a non-default catalog. Set this only when a second catalog
# is itself the default for its own front door.

# Locks against a non-default catalog are served by the synthetic shim.
HMS_SMOKE_LOCK_DB=apache__default
HMS_SMOKE_DB_LOCK_TYPE=SHARED_READ
HMS_SMOKE_DB_LOCK_LEVEL=DB
HMS_SMOKE_DB_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_DB_LOCK_TRANSACTIONAL=false
HMS_SMOKE_LOCK_HEARTBEAT=true
HMS_SMOKE_LOCK_UNLOCK=true
HMS_SMOKE_LOCK_CLOSE_TXN=abort

# Partition-style exclusive lock, the second synthetic-shim shape.
HMS_SMOKE_LOCK_TABLE=smoke_managed_tbl
HMS_SMOKE_LOCK_PARTITION=p=2026-04-01
HMS_SMOKE_PARTITION_LOCK_TYPE=EXCLUSIVE
HMS_SMOKE_PARTITION_LOCK_LEVEL=PARTITION
HMS_SMOKE_PARTITION_LOCK_OPERATION_TYPE=NO_TXN
HMS_SMOKE_PARTITION_LOCK_TRANSACTIONAL=false

# A lock request naming two catalogs at once — the shape Hive builds for a query reading across
# them. The proxy routes it by the default catalog and drops the other components; before that it
# refused the whole request. The first component comes from HMS_SMOKE_TXN_DB.
HMS_SMOKE_CROSS_CATALOG_LOCK_DB=apache__default
HMS_SMOKE_CROSS_CATALOG_LOCK_TABLE=smoke_txn_tbl

# Hortonworks write-notification path. It needs the proxy's Hortonworks listener (19086): the
# primary front door speaks Apache 3.1.3, which has no add_write_notification_log. The jar path is
# relative to the repo root, which is where this runner is meant to be started from.
HMS_SMOKE_NOTIFICATION_URI=thrift://localhost:19086
HMS_SMOKE_NOTIFICATION_DB=hdp__default
HMS_SMOKE_NOTIFICATION_TABLE=smoke_txn_tbl
HMS_SMOKE_NOTIFICATION_TXN_ID=1001
HMS_SMOKE_NOTIFICATION_WRITE_ID=2001
HMS_SMOKE_NOTIFICATION_FILES_ADDED=hdfs://namenode:8020/warehouse/hdp/smoke_txn_tbl/delta_1001_1001_0000/bucket_00000
HMS_SMOKE_NOTIFICATION_NEGATIVE_DB=apache__default
HMS_SMOKE_NOTIFICATION_NEGATIVE_TABLE=smoke_txn_tbl
HMS_SMOKE_HDP_STANDALONE_METASTORE_JAR=hive-metastore/hive-standalone-metastore-3.1.0.3.1.0.0-78.jar

# SQL layer. Left commented out because this runner is meant to be started from the host, where
# there is no beeline and no in-network DNS. To drive the SQL scenario, run it inside the stand's
# Hortonworks HiveServer2 container - it carries a beeline that reaches both front doors:
#
#   docker cp scripts/run-real-installation-smoke.sh stand-hs2-hdp:/opt/hs2-hdp/run-smoke.sh
#   docker exec stand-hs2-hdp /opt/hs2-hdp/run-smoke.sh --env-file <this file> --scenario sql
#
# With both URLs set the whole SQL suite runs twice: once against the Apache front door and once
# against the Hortonworks one, which is the only way an HDP client path gets covered - Thrift has
# no version negotiation, so neither client can use the other's listener.
# HMS_SMOKE_BEELINE_JDBC_URL=jdbc:hive2://hs2:10000/default
# HMS_SMOKE_BEELINE_HDP_JDBC_URL=jdbc:hive2://hs2-hdp:10000/default
# HMS_SMOKE_BEELINE_USER=hive
# HMS_SMOKE_APACHE_CATALOG=apache
# HMS_SMOKE_HDP_CATALOG=hdp
# HMS_SMOKE_HDP_READ_TABLE=smoke_read_hdp
# HMS_SMOKE_APACHE_READ_TABLE=smoke_read_ap
# HMS_SMOKE_HDP_EXTERNAL_ROOT=hdfs://namenode:8020/external/hdp
# The apache catalog lives on the second cluster, so its external root does too.
# HMS_SMOKE_APACHE_EXTERNAL_ROOT=hdfs://namenode-b:8020/external/apache
# The permanent-UDF block works: UDFReverse lives in hive-exec, which both HiveServer2 images now
# carry, so the default HMS_SMOKE_SQL_RUN_UDF=true is left alone.
# HMS_SMOKE_SQL_RUN_CROSS_DATABASE_JOIN=true

# Iceberg REST catalog front door (read-only). The smoke drives it with curl from the host.
# smoke_iceberg_tbl is a pre-registered Iceberg table (see smoke-stand/README.md);
# smoke_read_hdp is a plain Hive table that must stay invisible through REST.
HMS_SMOKE_REST_URL=http://localhost:19183
HMS_SMOKE_REST_PREFIX=hdp
HMS_SMOKE_REST_NAMESPACE=default
HMS_SMOKE_REST_ICEBERG_TABLE=smoke_iceberg_tbl
HMS_SMOKE_REST_NON_ICEBERG_TABLE=smoke_read_hdp

# Second catalog (apache), lives on the second HDFS cluster (namenode-b). Proves warehouse
# discovery and the clean view work for a non-default prefix too.
HMS_SMOKE_REST_SECOND_PREFIX=apache
HMS_SMOKE_REST_SECOND_ICEBERG_TABLE=smoke_iceberg_tbl_ap
HMS_SMOKE_REST_SECOND_NON_ICEBERG_TABLE=smoke_read_ap

# Table write round trip (create/commit/rename/drop) plus the two negatives (direct create under
# the non-default prefix, and create under the federated name of that prefix's namespace under the
# default prefix) - both must answer 403, since only the default catalog's commit path reaches a
# real backend lock. The name is distinct from every other table already on the stand so a rerun
# cannot collide with a leftover from a previous pass. Also gates a namespace DDL round trip
# (smoke_rest_ns), a view round trip (smoke_rest_view, in HMS_SMOKE_REST_NAMESPACE) and a
# multi-table transaction commit round trip (<this name>_txn) - the same default-catalog
# restriction applies to all of them.
HMS_SMOKE_REST_WRITE_TABLE=smoke_rest_written

# Management metrics endpoint, reachable from the host. When set, the REST smoke also checks it
# carries the hms_proxy_rest_requests_total and hms_proxy_rest_listener_info series.
HMS_SMOKE_REST_METRICS_URL=http://localhost:19090/metrics
